profiles {
    low_cov {
        params.badread_error_model         = 'nanopore2020'
        params.badread_qscore_model        = 'nanopore2020'
        params.badread_random_reads        = 0
        params.badread_junk_reads          = 0
        params.badread_length              = '2700,500'
        params.badread_low_coverage_cutoff = 1
        params.badread_low_coverage_length = '400,100'
        params.generate_metadata           = true
        params.downsample_background       = false
        params.tag_simulated_reads         = true
        params.coverages                   = '0.1,1,10,20'
        params.auto_ingest                 = true
        params.outdir                      = 'output/low_cov'
        params.tracedir                    = 'output/low_cov/pipeline_info'
    }
    per_segment {
        params.badread_error_model   = 'nanopore2020'
        params.badread_qscore_model  = 'nanopore2020'
        params.badread_random_reads  = 0
        params.badread_junk_reads    = 0
        params.badread_length        = '2700,500'
        params.badread_per_segment   = true
        params.generate_metadata     = true
        params.downsample_background = false
        params.tag_simulated_reads   = true
        params.coverages             = '0.1,1,10,20'
        params.auto_ingest           = true
        params.outdir                = 'output/per_segment'
        params.tracedir              = 'output/per_segment/pipeline_info'
    }
    default {
        params.badread_error_model   = 'nanopore2020'
        params.badread_qscore_model  = 'nanopore2020'
        params.badread_random_reads  = 0
        params.badread_junk_reads    = 0
        params.badread_length        = '2700,500'
        params.generate_metadata     = true
        params.downsample_background = false
        params.tag_simulated_reads   = true
        params.coverages             = '0.1,1,10,20'
        params.auto_ingest           = true
        params.outdir                = 'output/default'
        params.tracedir              = 'output/default/pipeline_info'
    }
}
