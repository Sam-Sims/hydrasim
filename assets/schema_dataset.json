{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hydrasim dataset samplesheet schema",
  "description": "Schema for the single-end background datasets CSV used by Hydrasim",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "meta": ["id"],
        "pattern": "^\\S+$",
        "errorMessage": "Dataset ID must be provided and cannot contain spaces"
      },
      "accession": {
        "meta": ["accession"],
        "anyOf": [
          { "const": "" },
          {
            "type": "string",
            "pattern": "^\\S+$"
          }
        ],
        "errorMessage": "Accession should be blank or a non-empty SRA accession without spaces"
      },
      "source_climb_id": {
        "meta": ["source_climb_id"],
        "anyOf": [
          { "const": "" },
          {
            "type": "string",
            "pattern": "^\\S+$"
          }
        ],
        "errorMessage": "Source CLIMB ID should be blank or ID"
      },
      "reads": {
        "anyOf": [
          { "const": "" },
          {
            "type": "string",
            "format": "file-path",
            "exists": true,
            "pattern": "^\\S+$"
          }
        ],
        "errorMessage": "Path to FASTQ should be blank or a local/S3 file path without spaces"
      }
    },
    "required": ["id"],
    "additionalProperties": false,
    "oneOf": [
      {
        "required": ["accession"],
        "properties": {
          "accession": {
            "type": "string",
            "pattern": "^\\S+$"
          },
          "source_climb_id": {
            "const": ""
          },
          "reads": {
            "const": ""
          }
        }
      },
      {
        "required": ["reads"],
        "properties": {
          "accession": {
            "const": ""
          },
          "reads": {
            "type": "string",
            "format": "file-path",
            "pattern": "^\\S+$"
          }
        }
      }
    ],
    "errorMessage": {
      "oneOf": "Each dataset row must provide exactly one source: an SRA accession, or a single-end FASTQ path in reads"
    }
  }
}
