outputDir = 'output'
workflow.output.mode = 'copy'

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/profiles.config'

plugins {
    id 'nf-schema@3.0.0'
}

manifest {
    name            = 'Hydrasim'
    description     = 'Generate synthetic spiked-in metagenomic datasets.'
    nextflowVersion = '>=26.10.3'
    version         = 'v0.4.0'
}

profiles {
    docker {
        docker.enabled = true
    }
    podman {
        podman.enabled = true
    }
    test {
        includeConfig 'conf/test.config'
    }
    restrict {
        executor {
            queueSize = 12
        }
        process {
            withName: 'BADREAD_SIMULATE_SEGMENT|BADREAD_SIMULATE_WHOLE_REFERENCE' {
                maxForks = 4
            }
        }
    }
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

env {
    HYDRASIM_UPLOAD_BUCKET           = env('HYDRASIM_UPLOAD_BUCKET')
    AWS_ACCESS_KEY_ID                = env('AWS_ACCESS_KEY_ID')
    AWS_SECRET_ACCESS_KEY            = env('AWS_SECRET_ACCESS_KEY')
    AWS_REQUEST_CHECKSUM_CALCULATION = env('AWS_REQUEST_CHECKSUM_CALCULATION')
}
